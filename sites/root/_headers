# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://get.geojs.io https://api.open-meteo.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# the résumé PDF: browsers' built-in viewers can render blank under the
# site-wide default-src 'none' and frame-ancestors 'none'. It is a static
# file with no scripts, so it gets neither.
/athreyas-yelishetti-resume.pdf
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Disposition: inline; filename="Athreyas-Yelishetti-Resume.pdf"
